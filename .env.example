# CurveAlpha settings. Copy to .env and fill in. Secrets stay in this file only.
CURVEALPHA_MODE=paper
CURVEALPHA_GRPC_ENDPOINT=https://your-yellowstone-endpoint:443
CURVEALPHA_GRPC_TOKEN=
CURVEALPHA_RPC_URL=https://api.mainnet-beta.solana.com
CURVEALPHA_PAPER_SOL=2
# Live mode only: a dedicated keypair holding nothing but the trading bankroll (chmod 600)
CURVEALPHA_KEYPAIR=
CURVEALPHA_BLOCK_ENGINE_URL=https://ny.mainnet.block-engine.jito.wtf
CURVEALPHA_BAM_URL=
CURVEALPHA_JITO_UUID=
CURVEALPHA_X_BEARER=
CURVEALPHA_DATA_DIR=data
CURVEALPHA_DASHBOARD_PORT=7420
# json for JSON lines; leave empty for timestamped text lines
CURVEALPHA_LOG_FORMAT=
